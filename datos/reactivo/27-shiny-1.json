{"codigo":"library(shiny)\n\nnota_final <- function(notas, pesos) sum(notas * pesos)\n\nui <- fluidPage(\n  titlePanel(\"Mi nota final\"),\n  sliderInput(\"examen1\", \"Primer examen\", min = 0, max = 10, value = 6, step = 0.5),\n  sliderInput(\"examen2\", \"Segundo examen\", min = 0, max = 10, value = 8, step = 0.5),\n  sliderInput(\"peso\", \"Peso del primer examen\", min = 0, max = 1, value = 0.4, step = 0.1),\n  textOutput(\"nota\"),\n  textOutput(\"veredicto\"),\n  plotOutput(\"barras\", height = \"250px\")\n)\n\nserver <- function(input, output, session) {\n  nota <- reactive({\n    nota_final(c(input$examen1, input$examen2), c(input$peso, 1 - input$peso))\n  })\n  output$nota <- renderText({\n    paste(\"Tu nota final es\", round(nota(), 2))\n  })\n  output$veredicto <- renderText({\n    if (nota() >= 5) \"Apruebas\" else \"Suspendes\"\n  })\n  output$barras <- renderPlot({\n    barplot(c(input$examen1, input$examen2), names.arg = c(\"Examen 1\", \"Examen 2\"),\n            ylim = c(0, 10), col = \"#7A1F36\")\n  })\n}\n\nshinyApp(ui, server)","ui":{"titulo":"Mi nota final","entradas":[{"id":"examen1","etiqueta":"Primer examen","min":0,"max":10,"valor":6,"paso":0.5,"tipo":"sliderInput"},{"id":"examen2","etiqueta":"Segundo examen","min":0,"max":10,"valor":8,"paso":0.5,"tipo":"sliderInput"},{"id":"peso","etiqueta":"Peso del primer examen","min":0,"max":1,"valor":0.4,"paso":0.1,"tipo":"sliderInput"}],"salidas":[{"id":"nota","tipo":"text"},{"id":"veredicto","tipo":"text"},{"id":"barras","tipo":"plot"}]},"nodos":[{"id":"nota","clase":"reactiva","lineas":[16,18],"lee":["input$examen1","input$examen2","input$peso"]},{"id":"output$nota","clase":"salida","tipo":"Text","lineas":[19,21],"lee":["nota"]},{"id":"output$veredicto","clase":"salida","tipo":"Text","lineas":[22,24],"lee":["nota"]},{"id":"output$barras","clase":"salida","tipo":"Plot","lineas":[25,28],"lee":["input$examen1","input$examen2"]}],"estados":[{"cambio":null,"entradas":{"examen1":6,"examen2":8,"peso":0.4},"registro":["output$nota","nota","output$veredicto","output$barras"],"salidas":{"nota":{"texto":"Tu nota final es 7.2"},"veredicto":{"texto":"Apruebas"},"barras":{"imagen":"datos/graficos/27-shiny-r1-1.png"}}},{"cambio":{"peso":0.7},"entradas":{"examen1":6,"examen2":8,"peso":0.7},"registro":["output$nota","nota","output$veredicto"],"salidas":{"nota":{"texto":"Tu nota final es 6.6"},"veredicto":{"texto":"Apruebas"},"barras":{"imagen":"datos/graficos/27-shiny-r1-2.png"}},"caducan":["nota","output$nota","output$veredicto"]},{"cambio":{"examen2":3},"entradas":{"examen1":6,"examen2":3,"peso":0.7},"registro":["output$barras","output$nota","nota","output$veredicto"],"salidas":{"nota":{"texto":"Tu nota final es 5.1"},"veredicto":{"texto":"Apruebas"},"barras":{"imagen":"datos/graficos/27-shiny-r1-3.png"}},"caducan":["nota","output$barras","output$nota","output$veredicto"]},{"cambio":{"examen1":2},"entradas":{"examen1":2,"examen2":3,"peso":0.7},"registro":["output$barras","output$nota","nota","output$veredicto"],"salidas":{"nota":{"texto":"Tu nota final es 2.3"},"veredicto":{"texto":"Suspendes"},"barras":{"imagen":"datos/graficos/27-shiny-r1-4.png"}},"caducan":["nota","output$barras","output$nota","output$veredicto"]}],"shinylive":"https://shinylive.io/r/editor/#-PxeK0GSKBeUBXooAB8sxXF8YAAIJUrsFrWmAwzUH6UHfJonDmAux5gOUd5Yg+DYWowVrpvOuJhEaTQ-r+xGGhIpblo+NYQGyigDixLamNA8CcBgLCRKsZbFAAok2EJdOMoniYoHwlPqv6KUprB0DAQnsBs6ytsQSizMUADEADs0EdAAYgAzPsXpYvho4iL6vD8LBqDsH48aMAG3h4GApCsOYVBiqQYCjgAukAA"}
