{"codigo":"library(shiny)\n\nnota_final <- function(notas, pesos) sum(notas * pesos)\n\nui <- fluidPage(\n  sliderInput(\"examen1\", \"Primer examen\", min = 0, max = 10, value = 6, step = 0.5),\n  sliderInput(\"examen2\", \"Segundo examen\", min = 0, max = 10, value = 8, step = 0.5),\n  sliderInput(\"peso\", \"Peso del primer examen\", min = 0, max = 1, value = 0.4, step = 0.1),\n  textOutput(\"nota\"),\n  textOutput(\"veredicto\")\n)\n\nserver <- function(input, output, session) {\n  output$nota <- renderText({\n    nota <- nota_final(c(input$examen1, input$examen2), c(input$peso, 1 - input$peso))\n    paste(\"Tu nota final es\", round(nota, 2))\n  })\n  output$veredicto <- renderText({\n    nota <- nota_final(c(input$examen1, input$examen2), c(input$peso, 1 - input$peso))\n    if (nota >= 5) \"Apruebas\" else \"Suspendes\"\n  })\n}\n\nshinyApp(ui, server)","ui":{"titulo":null,"entradas":[{"id":"examen1","etiqueta":"Primer examen","min":0,"max":10,"valor":6,"paso":0.5,"tipo":"sliderInput"},{"id":"examen2","etiqueta":"Segundo examen","min":0,"max":10,"valor":8,"paso":0.5,"tipo":"sliderInput"},{"id":"peso","etiqueta":"Peso del primer examen","min":0,"max":1,"valor":0.4,"paso":0.1,"tipo":"sliderInput"}],"salidas":[{"id":"nota","tipo":"text"},{"id":"veredicto","tipo":"text"}]},"nodos":[{"id":"output$nota","clase":"salida","tipo":"Text","lineas":[14,17],"lee":["input$examen1","input$examen2","input$peso"]},{"id":"output$veredicto","clase":"salida","tipo":"Text","lineas":[18,21],"lee":["input$examen1","input$examen2","input$peso"]}],"estados":[{"cambio":null,"entradas":{"examen1":6,"examen2":8,"peso":0.4},"registro":["output$nota","output$veredicto"],"salidas":{"nota":{"texto":"Tu nota final es 7.2"},"veredicto":{"texto":"Apruebas"}}},{"cambio":{"peso":0.7},"entradas":{"examen1":6,"examen2":8,"peso":0.7},"registro":["output$nota","output$veredicto"],"salidas":{"nota":{"texto":"Tu nota final es 6.6"},"veredicto":{"texto":"Apruebas"}},"caducan":["output$nota","output$veredicto"]}],"shinylive":"https://shinylive.io/r/editor/#-DoYAAsALgczaC0KIOeinIuVIAHlMlDskYoCU6fFGSy2TsSkNknAQrRdERuSJvCJOMlhTU1BptLp9BB2HwoaYiALSNMLJw1TYQGsdaQoQASTkBRSMCibAAqeSyJvp8WtSs5snk1HYBA121IFr2RVMmsywbuFAOK0U-vDQdhRFMhUU6gTFqTAm88XiqGc5GyDs0imtcmgSgsD0YOogIUcklMMZzigAvi2zZaFaLxaQbkq7XXkk6mexXbnS04bV7ywo-QHLSGIATFBmlzHTPHA5nPCm06vt1mW-FaDJFA2oIoAHxtZZlMAAQVRY3ozhKtWocvvp00nHMQ84Eo1nbERWxEWVeH4J9UHYPx9UYBVvDwMBSFYcwqD5MBWwAXSAA"}
