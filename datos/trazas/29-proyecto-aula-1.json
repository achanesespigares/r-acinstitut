{"codigo":"nota_necesaria <- function(notas, pesos, objetivo = 5) {\n  if (length(pesos) != length(notas) + 1) {\n    stop(\"tiene que haber un peso más que notas: el del último examen\")\n  }\n  if (abs(sum(pesos) - 1) > 1e-8) {\n    stop(\"los pesos suman \", sum(pesos), \", no 1\")\n  }\n  hecho <- sum(notas * pesos[seq_along(notas)])\n  falta <- (objetivo - hecho) / pesos[length(pesos)]\n  max(falta, 0)\n}\nnota_necesaria(c(6, 4), c(0.3, 0.3, 0.4))\nnota_necesaria(c(9, 8), c(0.3, 0.3, 0.4))\nnota_necesaria(c(6, 4), c(0.5, 0.5))","pasos":[{"linea":null,"tipo":"inicio","estado":{},"salida":"","nfilas":0},{"linea":1,"tipo":"linea","estado":{"nota_necesaria":{"t":"function","r":"function(notas, pesos, objetivo)"}},"salida":"","nfilas":0},{"linea":1,"tipo":"llamada","funcion":"nota_necesaria","estado":{"nota_necesaria":{"t":"function","r":"function(notas, pesos, objetivo)"}},"marcos":[{"id":1,"nombre":"nota_necesaria","llamada":"nota_necesaria(notas = 6 4, pesos = 0.3 0.3 0.4, objetivo = 5)","desde":12,"vars":{"notas":{"t":"numeric","v":["6","4"]},"pesos":{"t":"numeric","v":["0.3","0.3","0.4"]},"objetivo":{"t":"numeric","v":["5"]}},"padre":"Programa principal"}],"salida":"","nfilas":0},{"linea":2,"tipo":"condicion","cond":{"texto":"length(pesos) != length(notas) + 1","valores":"3 != 2 + 1","valor":"FALSE"},"estado":{"nota_necesaria":{"t":"function","r":"function(notas, pesos, objetivo)"}},"marcos":[{"id":1,"nombre":"nota_necesaria","llamada":"nota_necesaria(notas = 6 4, pesos = 0.3 0.3 0.4, objetivo = 5)","desde":12,"vars":{"notas":{"t":"numeric","v":["6","4"]},"pesos":{"t":"numeric","v":["0.3","0.3","0.4"]},"objetivo":{"t":"numeric","v":["5"]}},"padre":"Programa principal"}],"salida":"","nfilas":0},{"linea":5,"tipo":"condicion","cond":{"texto":"abs(sum(pesos) - 1) > 1e-08","valores":"abs(1 - 1) > 1e-08","valor":"FALSE"},"estado":{"nota_necesaria":{"t":"function","r":"function(notas, pesos, objetivo)"}},"marcos":[{"id":1,"nombre":"nota_necesaria","llamada":"nota_nece