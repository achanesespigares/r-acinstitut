{"codigo":"library(testthat)\nnota_final <- function(notas, pesos) {\n  if (length(notas) != length(pesos)) {\n    stop(\"hay \", length(notas), \" notas y \", length(pesos), \" pesos\")\n  }\n  if (any(notas < 0 | notas > 10)) {\n    warning(\"hay notas fuera de 0-10\")\n  }\n  sum(notas * pesos)\n}\ntest_that(\"nota_final hace la media ponderada\", {\n  expect_equal(nota_final(c(6, 8), c(0.4, 0.6)), 7.2)\n  expect_equal(nota_final(c(6, 7), c(0.3, 0.7)), 6.7)\n})\ntest_that(\"nota_final avisa y se para cuando debe\", {\n  expect_warning(nota_final(c(6, 11), c(0.4, 0.6)), \"fuera de 0-10\")\n  expect_error(nota_final(c(6, 8), c(0.2, 0.3, 0.5)), \"2 notas y 3 pesos\")\n})","pasos":[{"linea":null,"tipo":"inicio","estado":{},"salida":"","nfilas":0},{"linea":1,"tipo":"linea","estado":{},"salida":"","nfilas":0},{"linea":2,"tipo":"linea","estado":{"nota_final":{"t":"function","r":"function(notas, pesos)"}},"salida":"","nfilas":0},{"linea":2,"tipo":"llamada","funcion":"nota_final","estado":{"nota_final":{"t":"function","r":"function(notas, pesos)"}},"marcos":[{"id":1,"nombre":"nota_final","llamada":"nota_final(notas = 6 8, pesos = 0.4 0.6)","desde":11,"vars":{"notas":{"t":"numeric","v":["6","8"]},"pesos":{"t":"numeric","v":["0.4","0.6"]}},"padre":"Programa principal"}],"salida":"","nfilas":0},{"linea":3,"tipo":"condicion","cond":{"texto":"length(notas) != length(pesos)","valores":"2 != 2","valor":"FALSE"},"estado":{"nota_final":{"t":"function","r":"function(notas, pesos)"}},"marcos":[{"id":1,"nombre":"nota_final","llamada":"nota_final(notas = 6 8, pesos = 0.4 0.6)","desde":11,"vars":{"notas":{"t":"numeric","v":["6","8"]},"pesos":{"t":"numeric","v":["0.4","0.6"]}},"padre":"Programa principal"}],"salida":"","nfilas":0},{"linea":6,"tipo":"condicion","cond":{"texto":"any(notas < 0 | notas > 10)","valores":"any(notas < 0 | notas > 10)","valor":"FALSE"},"estado":{"nota_final":{"t":"function","r":"function(notas, pesos)"}},"marcos":[{"id":1,"nombre":"nota_final","llamada":"nota_f