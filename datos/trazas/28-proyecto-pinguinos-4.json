{"codigo":"diferencia_sexos <- function(datos, sp) {\n  d <- datos[datos$especie == sp & !is.na(datos$sexo) & !is.na(datos$masa_corporal_g), ]\n  if (nrow(d) == 0) stop(\"no hay pingüinos de la especie \", sp)\n  medias <- tapply(d$masa_corporal_g, d$sexo, mean)\n  prueba <- t.test(masa_corporal_g ~ sexo, data = d)\n  list(especie = sp,\n       machos = unname(medias[\"macho\"]),\n       hembras = unname(medias[\"hembra\"]),\n       diferencia = unname(medias[\"macho\"] - medias[\"hembra\"]),\n       p = prueba$p.value)\n}\npinguinos <- read.csv(\"datos/pinguinos.csv\")\nadelia <- diferencia_sexos(pinguinos, \"Adelia\")\nadelia$diferencia\nadelia$p < 0.001\ndiferencia_sexos(pinguinos, \"Emperador\")","pasos":[{"linea":null,"tipo":"inicio","estado":{},"salida":"","nfilas":0},{"linea":1,"tipo":"linea","estado":{"diferencia_sexos":{"t":"function","r":"function(datos, sp)"}},"salida":"","nfilas":0},{"linea":12,"tipo":"linea","estado":{"diferencia_sexos":{"t":"function","r":"function(datos, sp)"},"pinguinos":{"t":"data.frame","nf":344,"cols":[{"nombre":"especie","v":{"t":"character","v":["\"Adelia\"","\"Adelia\"","\"Adelia\"","\"Adelia\"","\"Adelia\"","\"Adelia\"","\"Adelia\"","\"Adelia\""]}},{"nombre":"isla","v":{"t":"character","v":["\"Torgersen\"","\"Torgersen\"","\"Torgersen\"","\"Torgersen\"","\"Torgersen\"","\"Torgersen\"","\"Torgersen\"","\"Torgersen\""]}},{"nombre":"largo_pico_mm","v":{"t":"numeric","v":["39.1","39.5","40.3","NA","36.7","39.3","38.9","39.2"]}},{"nombre":"alto_pico_mm","v":{"t":"numeric","v":["18.7","17.4","18","NA","19.3","20.6","17.8","19.6"]}},{"nombre":"largo_aleta_mm","v":{"t":"integer","v":["181","186","195","NA","193","190","181","195"]}},{"nombre":"masa_corporal_g","v":{"t":"integer","v":["3750","3800","3250","NA","3450","3650","3625","4675"]}},{"nombre":"sexo","v":{"t":"character","v":["\"macho\"","\"hembra\"","\"hembra\"","NA","\"hembra\"","\"macho\"","\"hembra\"","\"macho\""]}},{"nombre":"anio","v":{"t":"integer","v":["2007","2007","200